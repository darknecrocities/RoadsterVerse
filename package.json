{
  "name": "thrust-weight-rl-sandbox",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "THRUST//WEIGHT: Interactive 3D Reinforcement Learning & Cold-Gas / Raptor Physics Sandbox for the 2026 Tesla Roadster (SpaceX Package) and SpaceX Starship",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 127.0.0.1 --port 5173",
    "dev:server": "tsx --no-warnings server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --no-warnings dist-server/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:lines": "python3 scripts/check_source_line_limits.py --path ."
  },
  "dependencies": {
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.173.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.173.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
