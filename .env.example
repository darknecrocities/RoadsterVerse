# THRUST//WEIGHT Server & Environment Configuration
# Copy this file to .env and adjust values as needed. Never commit raw production secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DB_PATH=./data/thrust_weight.db
CORS_ORIGIN=http://127.0.0.1:5173
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_MS=60000
